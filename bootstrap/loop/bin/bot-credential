#!/bin/bash
# Git credential helper for the bootstrap driver: answers `get` for github.com with a fresh
# installation token. run.sh passes it per command (`git -c credential.helper=...`); it is never
# in global git config, so the Claude session's git has no credential.
[ "$1" = "get" ] || exit 0
host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in host=*) host="${line#host=}" ;; esac
done
[ "$host" = "github.com" ] || exit 0
here="$(cd "$(dirname "$0")/.." && pwd)"
tok="$(bun "$here/token.ts")" || exit 1
printf 'username=x-access-token\npassword=%s\n' "$tok"
