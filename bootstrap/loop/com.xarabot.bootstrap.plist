<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A LaunchDaemon, not a LaunchAgent: the bootstrap user is reached over ssh and never logs in
     at the screen, so it has no gui/<uid> domain. launchd runs the job as UserName.
     Install (as an admin, see README.md):
     sed "s|__USER__|edanisko-xarabot|g" com.xarabot.bootstrap.plist | sudo tee /Library/LaunchDaemons/com.xarabot.bootstrap.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xarabot.bootstrap</string>
  <key>UserName</key>
  <string>__USER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/__USER__/.xarabot-bootstrap/run.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/__USER__</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/__USER__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/__USER__/.xarabot-bootstrap/state/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/__USER__/.xarabot-bootstrap/state/launchd.log</string>
</dict>
</plist>
